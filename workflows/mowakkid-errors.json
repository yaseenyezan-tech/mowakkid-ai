      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { timestamp: new Date().toISOString(), workflow: String(e.workflow?.name ?? 'Mowakkid AI').slice(0,160), execution_id: String(e.execution?.id ?? ''), node: String(e.execution?.lastNodeExecuted ?? e.trigger?.error?.node?.name ?? 'activation'), error_code: String(e.execution?.error?.name ?? e.trigger?.error?.name ?? 'ExecutionError').slice(0,80), message_id: '', message: 'Execution failed. Open the execution in n8n to investigate; raw errors/payloads are intentionally not copied.' } }];"
      },
      "notes": "Node version 2; check fields if n8n offers an upgrade."
    },
